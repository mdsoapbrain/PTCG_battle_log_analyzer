# Runtime
APP_NAME=PTCG Battle Log Backend
APP_VERSION=0.2.2
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
API_PREFIX=

# Database
# Local SQLite (default)
DATABASE_URL=sqlite:///./backend.db

# Supabase / Postgres examples:
# DATABASE_URL=postgresql://postgres:password@db-host:5432/postgres
# DATABASE_URL=postgresql+psycopg://postgres:password@db-host:5432/postgres?sslmode=require
#
# Notes:
# - This app auto-normalizes postgres:// and postgresql:// into postgresql+psycopg://
# - For production persistence, do not keep Render on sqlite:///./backend.db

# Frontend integration
API_BASE_URL=http://localhost:8001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-lovable-frontend.example.com
CORS_ALLOWED_ORIGIN_REGEX=https://.*\\.vercel\\.app

# Security / auth mode
SECRET_KEY=change-me-for-production
AUTH_MODE=stub
# AUTH_MODE options: stub | supabase_jwt
